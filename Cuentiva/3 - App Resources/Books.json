  {
    "id": "sea",
    "title": "Aprender a nadar",
    "englishTitle": "Learning to swim",
    "author": "Diego · demo narrator",
    "level": "A2",
    "symbol": "water.waves",
    "palette": 3,
    "summary": "Starting something new is easier with a friend beside you.",
    "sentences": [
      {
        "id": "sea-1",
        "spanish": "Cuando era niño, tenía miedo del agua.",
        "english": "When I was a child, I was afraid of water."
      },
      {
        "id": "sea-2",
        "spanish": "Este año decidí aprender a nadar.",
        "english": "This year I decided to learn to swim."
      },
      {
        "id": "sea-3",
        "spanish": "Mi amiga Elena vino conmigo a la piscina.",
        "english": "My friend Elena came with me to the pool."
      },
      {
        "id": "sea-4",
        "spanish": "La primera clase fue difícil.",
        "english": "The first lesson was difficult."
      },
      {
        "id": "sea-5",
        "spanish": "El profesor nos pidió respirar despacio.",
        "english": "The teacher asked us to breathe slowly."
      },
      {
        "id": "sea-6",
        "spanish": "Después de varias semanas, me sentí mejor.",
        "english": "After several weeks, I felt better."
      },
      {
        "id": "sea-7",
        "spanish": "Ayer nadé sin ayuda por primera vez.",
        "english": "Yesterday I swam without help for the first time."
      },
      {
        "id": "sea-8",
        "spanish": "Elena sonrió y yo empecé a reír.",
        "english": "Elena smiled and I began to laugh."
      },
      {
        "id": "sea-9",
        "spanish": "Todavía aprendo, pero ya no tengo tanto miedo.",
        "english": "I am still learning, but I am no longer so afraid."
      }
    ],

        "id": "train-2",
        "spanish": "Quería visitar a mi abuela.",
        "english": "I wanted to visit my grandmother."
      },
      {
        "id": "train-3",
        "spanish": "No la veía desde el verano.",
        "english": "I had not seen her since the summer."
      },
      {
        "id": "train-4",
        "spanish": "En la estación había mucha gente.",
        "english": "There were many people at the station."
      },
      {
        "id": "train-5",
        "spanish": "Encontré un asiento junto a la ventana.",
        "english": "I found a seat next to the window."
      },
      {
        "id": "train-6",
        "spanish": "Durante el viaje miré las montañas.",
        "english": "During the journey I looked at the mountains."
      },
      {
        "id": "train-7",
        "spanish": "Mi abuela me esperaba en la puerta.",
        "english": "My grandmother was waiting for me at the door."
      },
      {
        "id": "train-8",
        "spanish": "Hicimos sopa y hablamos hasta tarde.",
        "english": "We made soup and talked until late."
      },
      {
        "id": "train-9",
